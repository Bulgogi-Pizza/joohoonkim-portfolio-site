# 로컬 개발용: .env.local 로 복사해서 사용 (.env*.local 은 git 에 올라가지 않음)
# 배포(Amplify)에서는 콘솔 환경변수로 설정한다. 하나만 설정해도 amplify.yml 이 나머지를 채운다.

# /api/* 요청을 프록시할 백엔드 주소 (next.config.js rewrites)
API_URL=https://api.photonicsskku.com
# 브라우저에서 직접 백엔드를 부를 때 사용 (lib/imageUtils.ts, admin hero 활성화)
NEXT_PUBLIC_API_URL=https://api.photonicsskku.com
# 사이트 기본 주소 (metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://www.photonicsskku.com
